# Server environment variables (copy to .env and fill in real values)

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/mess-manager

# Long random string used to sign the JWT
JWT_SECRET=change-this-to-a-long-random-secret

# Session length in days
JWT_EXPIRES_IN_DAYS=7

# Frontend origin allowed by CORS, no trailing slash
CLIENT_ORIGIN=http://localhost:3000

# Auth cookie is always secure; set false only if you must test over
# plain http on a non-localhost host
COOKIE_SECURE=true

# none by default so the cookie works across different domains
# (e.g. two Vercel projects); use lax when everything shares one domain
COOKIE_SAMESITE=none
